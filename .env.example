# Copie para .env e preencha. Nunca commite o .env.

# Banco (PostgreSQL 16+).
# Desenvolvimento: o `npm run db:start` sobe um PostgreSQL embutido com estes dados.
# Troque TROQUE-ESTA-SENHA por qualquer senha local.
DATABASE_URL="postgresql://postgres:TROQUE-ESTA-SENHA@localhost:54329/myflat"
# Produção (Supabase): Project Settings > Database > Connection string

# Senha dos usuários de teste criados pelo seed de desenvolvimento
# (admin@myflat.local e limpeza@myflat.local). Mínimo de 10 caracteres. Só para a sua máquina.
SEED_ADMIN_PASSWORD="TROQUE-ESTA-SENHA"

APP_URL="http://localhost:3000"

# Armazenamento de arquivos (fotos, documentos)
STORAGE_URL=""
STORAGE_SERVICE_KEY=""

# IA (Anthropic): crie em console.anthropic.com > API Keys. Sem ela, a captura com IA fica desativada.
ANTHROPIC_API_KEY=""
# Liga a organização automática de pendências por IA. Deixe "false" enquanto a conta não tiver créditos.
MYFLAT_AI_ENABLED="false"
# Opcional: outro modelo (padrão claude-opus-5-5)
MYFLAT_AI_MODEL=""

# WhatsApp Business Platform (Cloud API). Vazio = modo demonstração
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_APP_SECRET=""     # valida a assinatura dos webhooks
WHATSAPP_VERIFY_TOKEN=""   # usado na verificação do webhook

# Jobs agendados (sync iCal, expiração de pré-reservas)
CRON_SECRET=""
